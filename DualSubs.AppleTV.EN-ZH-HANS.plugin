#!name = 🍿️ DualSubs: Apple TV · EN + 简体中文
#!desc = 流媒体平台字幕增强及双语模块\n如需恢复TV完整支持\n请配合“ iRingo: 📺 TV”使用
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://DualSubs.github.io/guide/universal
#!icon = https://github.com/DualSubs/Universal/raw/main/src/assets/icon_rounded.png
#!tag = 🍿️ DualSubs
#!system = iOS,iPadOS,macOS,tvOS
#!date = 2026-11-03 07:41:05
#!version = 1.8.3
#!system_version = 15

# Configuration variant: Apple TV rules only. Official DualSubs v1.8.3 scripts remain unchanged.

[Argument]
Types = input,"Translate",tag=[字幕] 启用类型,desc=请选择要添加的字幕选项，如果为标准播放器，则会在字幕选项中新增勾选字幕选项。
Languages[0] = select,"EN","AUTO","ZH","ZH-HANS","ZH-HK","ZH-HANT","ES","JA","KO","DE","FR","TR","KM","AR","ID",tag=[字幕] 主语言（源语言）,desc=当“主语言”字幕存在时，将生成“主语言/副语言（翻译）”与“主语言（外挂）”的字幕或字幕选项。
Languages[1] = select,"ZH-HANS","ZH","ZH-HK","ZH-HANT","EN","EN-US","ES","ES-ES","ES-419","JA","KO","DE","FR","TR","KM","AR","ID",tag=[字幕] 副语言（目标语言）,desc=当“副语言”字幕存在时，将生成“副语言/主语言（官方）”的字幕或字幕选项。
Position = select,"Forward","Reverse",tag=[字幕] 主语言（源语言）字幕位置,desc=主语言（源语言）字幕的显示位置。
Vendor = select,"Google","Microsoft",tag=[翻译器] 服务商API,desc=请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。
ShowOnly = switch,false,tag=[翻译器] 只显示翻译字幕,desc=是否仅显示翻译后字幕，不显示源语言字幕。
Storage = select,"Argument","PersistentStore","database",tag=[储存] 配置类型,desc=默认优先使用设置面板或 BoxJS 保存的配置，其次使用插件配置，最后使用脚本默认配置。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Script]
http-response ^https?:\/\/(play|play-edge|hls)\.itunes\.apple\.com\/WebObjects\/(MZPlay|MZPlayLocal)\.woa\/hls\/playlist\.m3u8 requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Manifest.response.bundle.js, tag=🍿️ DualSubs.TV.M3U8.Master.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/vod-(.+)-amt\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)_subtitles(_V\d)?\.m3u8\?(.*)subtype= requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Manifest.response.bundle.js, tag=🍿️ DualSubs.TV.M3U8.Subtitles.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/vod-(.+)-amt\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)\.webvtt\?(.*)subtype=(Official|External) requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Composite.Subtitles.response.bundle.js, tag=🍿️ DualSubs.TV.Composite.Subtitles.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/vod-(.+)-amt\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)\.webvtt\?(.*)subtype=Translate requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Translate.response.bundle.js, tag=🍿️ DualSubs.TV.Translate.Subtitles.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/(play|play-edge|hls)\.itunes\.apple\.com\/WebObjects\/(MZPlay|MZPlayLocal)\.woa\/hls\/subscription\/playlist\.m3u8 requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Manifest.response.bundle.js, tag=🍿️ DualSubs.TV+.M3U8.Master.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/(play|play-edge|hls)\.itunes\.apple\.com\/WebObjects\/(MZPlay|MZPlayLocal)\.woa\/hls\/subscription\/stream\/playlist\.m3u8\?(.*)subtype= requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Manifest.response.bundle.js, tag=🍿️ DualSubs.TV+.M3U8.Subtitles.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/vod-(.+)-(aoc|svod)\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)_subtitles_V\d\.m3u8\?(.*)subtype= requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Manifest.response.bundle.js, tag=🍿️ DualSubs.TV+.M3U8.Subtitles.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/vod-(.+)-(aoc|svod)\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)\.webvtt\?(.*)subtype=(Official|External) requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Composite.Subtitles.response.bundle.js, tag=🍿️ DualSubs.TV+.Composite.Subtitles.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/vod-(.+)-(aoc|svod)\.tv\.apple\.com\/itunes-assets\/(.+)\/([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})\/(.+)\.webvtt\?(.*)subtype=Translate requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.8.3/Translate.response.bundle.js, tag=🍿️ DualSubs.TV+.Translate.Subtitles.response, argument=[{Types},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

[MITM]
hostname = hls.itunes.apple.com, hls-svod.itunes.apple.com, vod-*.tv.apple.com
